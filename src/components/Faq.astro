---
import { Icon } from 'astro-icon/components';
import { landingCopy } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const copy = landingCopy[lang].faq;
---
<section class="section faq" id="faq">
  <span class="ghost" aria-hidden="true">04</span>
  <div class="shell faq__inner">
    <header data-reveal><p class="eyebrow">{lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions'}</p><h2>{copy.title}</h2></header>
    <div>{copy.items.map(item => <details data-reveal>
      <summary><span class="q">{item.q}</span><span class="toggle" aria-hidden="true"><Icon name="ph:plus-light" /></span></summary>
      <p>{item.a}</p>
    </details>)}</div>
  </div>
</section>
<style>
  /* Accent: gold on dark, wine on light (white check ink on wine). */
  .faq { --mark: var(--gold); --mark-ink: #080808; overflow: hidden; }
  :global(:root[data-theme="light"]) .faq { --mark: var(--wine); --mark-ink: #ffffff; }
  /* Two-column section: the ghost sits in the empty space under the title, not behind the answers. */
  .faq .ghost { right: auto; top: auto; left: max(clamp(1.25rem, 5vw, 3rem), calc((100% - 80rem) / 2 + 3rem)); bottom: clamp(2.5rem, 7vh, 4.5rem); }
  @media (max-width: 767px) { .faq .ghost { left: auto; right: clamp(1.25rem, 5vw, 3rem); top: .9rem; bottom: auto; } }
  .faq__inner { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem, 5vw, 5rem); }
  h2 { max-width: 12ch; font-size: clamp(2.5rem, 5vw, 4.5rem); margin: 0; }
  details { position: relative; border-bottom: 1px solid var(--line); interpolate-size: allow-keywords; }
  details::before { content: ""; position: absolute; left: 0; top: 0; bottom: -1px; width: 2px; background: var(--mark); transform: scaleY(0); transform-origin: 50% 0; transition: transform .45s var(--ease-brand); }
  details[open]::before { transform: scaleY(1); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; list-style: none; cursor: pointer; color: var(--text-strong); padding: 1.5rem 0; font-size: clamp(1rem, 1.35vw, 1.15rem); font-weight: 500; transition: padding .45s var(--ease-brand), color .25s var(--ease-brand); }
  summary::-webkit-details-marker { display: none; }
  .toggle { display: grid; place-items: center; flex: none; width: 2.25rem; height: 2.25rem; border: 1px solid var(--line-strong); border-radius: 50%; color: var(--accent-text); transition: transform .45s var(--ease-brand), background-color .3s var(--ease-brand), border-color .3s var(--ease-brand), color .3s var(--ease-brand); }
  .toggle :global(svg) { width: 1.1rem; height: 1.1rem; }
  details[open] .toggle { transform: rotate(45deg); background: var(--mark); border-color: var(--mark); color: var(--mark-ink); }
  details p { max-width: 58ch; margin: 0; padding: 0 3.5rem 1.6rem 1.25rem; font-size: .95rem; font-weight: 500; }
  details[open] summary { padding-left: 1.25rem; }
  /* Smooth open/close where supported (Chromium 131+); instant elsewhere. */
  details::details-content { block-size: 0; overflow: hidden; opacity: 0; transition: block-size .45s var(--ease-brand), opacity .35s var(--ease-brand), content-visibility .45s allow-discrete; }
  details[open]::details-content { block-size: auto; opacity: 1; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    summary:hover { padding-left: 1.25rem; color: var(--accent-text); }
    summary:hover .toggle { transform: rotate(90deg); border-color: var(--mark); }
    details[open] summary:hover .toggle { transform: rotate(135deg); }
  }
  @media (max-width: 767px) { .faq__inner { grid-template-columns: 1fr; } h2 { max-width: 18ch; } details p { padding-right: 0; } }
</style>
