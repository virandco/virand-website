---
import Hero from './Hero.astro';
import Signature from './Signature.astro';
import Process from './Process.astro';
import Services from './Services.astro';
import Faq from './Faq.astro';
import Footer from './Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
---
<main id="main">
  <Hero /><Signature /><Process /><Services /><Faq />
  <section id="cuestionario" class="section shell"><h2>{lang === 'es' ? 'Cuéntanos tu proyecto' : 'Tell us about your project'}</h2></section>
</main>
<Footer />
