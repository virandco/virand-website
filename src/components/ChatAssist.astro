---
import { Icon } from 'astro-icon/components';
import { chatCopy } from '../i18n/chat';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const copy = chatCopy[lang];
---
<div class="chat" data-chat data-lang={lang}>
  <button class="chat__launcher" type="button" aria-expanded="false" aria-controls="chat-panel" data-chat-open>
    <Icon name="ph:chat-circle-dots" aria-hidden="true" />
    <span class="chat__label">{copy.launcher}</span>
  </button>
  <section class="chat__panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden data-chat-panel>
    <header class="chat__head">
      <div>
        <h2 id="chat-title">{copy.title}</h2>
        <p>{copy.subtitle}</p>
      </div>
      <button type="button" class="chat__close" aria-label={copy.close} data-chat-close><Icon name="ph:x" aria-hidden="true" /></button>
    </header>
    <div class="chat__log" role="log" aria-live="polite" aria-relevant="additions" tabindex="0" data-chat-log></div>
    <div class="chat__chips" data-chat-chips></div>
    <form class="chat__form" data-chat-form>
      <label class="chat__sr" for="chat-input">{copy.placeholder}</label>
      <input id="chat-input" name="q" type="text" maxlength="160" autocomplete="off" placeholder={copy.placeholder} data-chat-input />
      <button type="submit" aria-label={copy.send}><Icon name="ph:paper-plane-right" aria-hidden="true" /></button>
    </form>
  </section>
</div>
<script>import '../lib/chat';</script>
<style>
  /* Bottom-right square launcher, inverted against the theme (white on dark,
     obsidian on light). On hover it grows and reveals the question. The panel
     itself follows the active theme. */
  .chat { --launch-bg: #ffffff; --launch-ink: #080808; position: fixed; right: clamp(.75rem, 2vw, 1.5rem); bottom: clamp(.75rem, 2vw, 1.5rem); z-index: 55; }
  :global(:root[data-theme="light"]) .chat { --launch-bg: #080808; --launch-ink: #ffffff; }
  .chat__launcher {
    display: inline-flex; align-items: center; height: 3.25rem; min-width: 3.25rem; padding: 0 .95rem;
    background: var(--launch-bg); color: var(--launch-ink); border: 0; border-radius: var(--radius-sm);
    font: 600 .875rem/1 var(--font-body); cursor: pointer;
    box-shadow: 0 14px 34px -18px rgba(0, 0, 0, .55);
    transform-origin: 100% 100%;
    transition: transform .45s var(--ease-brand), padding .45s var(--ease-brand), box-shadow .35s var(--ease-brand), opacity .3s var(--ease-brand);
  }
  .chat__launcher :global(svg) { width: 1.35rem; height: 1.35rem; flex: none; transition: transform .45s var(--ease-brand); }
  .chat__label { display: inline-block; max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0; transition: max-width .5s var(--ease-brand), opacity .3s var(--ease-brand), margin .5s var(--ease-brand); }
  .chat__launcher:is(:hover, :focus-visible) { transform: scale(1.06); padding-inline: 1.1rem; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, .6); }
  .chat__launcher:is(:hover, :focus-visible) .chat__label { max-width: 9rem; opacity: 1; margin-left: .6rem; }
  .chat__launcher:is(:hover, :focus-visible) :global(svg) { transform: rotate(-10deg); }
  .chat__launcher:active { transform: scale(.97); }
  .chat[data-open] .chat__launcher { opacity: 0; pointer-events: none; }

  .chat__panel {
    position: absolute; right: 0; bottom: 0; display: grid; grid-template-rows: auto 1fr auto auto;
    width: min(23.5rem, calc(100vw - 1.5rem)); height: min(36rem, calc(100svh - 6rem));
    background: var(--bg-raised); color: var(--text); border: 1px solid var(--line-strong); border-top: 2px solid var(--gold);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, .7);
    transform-origin: 100% 100%;
  }
  .chat__panel[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .chat__panel:not([hidden]) { animation: chat-in .45s var(--ease-brand); }
  }
  @keyframes chat-in { from { opacity: 0; transform: translateY(.75rem) scale(.97); } }

  .chat__head { display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1rem .9rem 1.1rem; border-bottom: 1px solid var(--line); }
  .chat__head h2 { margin: 0; font: 700 1rem/1.1 var(--font-display); letter-spacing: .01em; color: var(--text-strong); }
  .chat__head p { margin: .3rem 0 0; font-size: .75rem; color: var(--text-dim); }
  .chat__close { display: grid; place-items: center; width: 2rem; height: 2rem; flex: none; border: 1px solid var(--line); background: transparent; color: var(--text-strong); cursor: pointer; transition: border-color .25s, transform .35s var(--ease-brand); }
  .chat__close:hover { border-color: var(--gold); transform: rotate(90deg); }
  .chat__close :global(svg) { width: 1rem; height: 1rem; }

  .chat__log { overflow-y: auto; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: .65rem; overscroll-behavior: contain; }
  .chat__log :global(.msg) { max-width: 88%; margin: 0; padding: .7rem .85rem; font-size: .85rem; line-height: 1.5; font-weight: 500; }
  .chat__log :global(.msg--bot) { align-self: flex-start; background: var(--bg-inset); color: var(--text-strong); border-left: 2px solid var(--gold); }
  .chat__log :global(.msg--user) { align-self: flex-end; background: var(--wine); color: #fff; }
  .chat__log :global(.msg p) { margin: 0; }
  .chat__log :global(.msg p + p) { margin-top: .45rem; }
  .chat__log :global(.msg__actions) { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .7rem; }
  .chat__log :global(.msg__actions a) { display: inline-flex; padding: .45rem .65rem; font-size: .75rem; font-weight: 600; background: var(--gold); color: #080808; transition: background-color .2s; }
  .chat__log :global(.msg__actions a:hover) { background: var(--gold-bright); }
  .chat__log :global(.msg--typing) { display: flex; gap: .25rem; padding: .85rem; }
  .chat__log :global(.msg--typing i) { width: .35rem; height: .35rem; border-radius: 50%; background: var(--text-dim); animation: chat-dot 1s infinite ease-in-out; }
  .chat__log :global(.msg--typing i:nth-child(2)) { animation-delay: .15s; }
  .chat__log :global(.msg--typing i:nth-child(3)) { animation-delay: .3s; }
  @keyframes chat-dot { 50% { transform: translateY(-3px); opacity: .4; } }

  .chat__chips { display: flex; flex-wrap: wrap; gap: .4rem; padding: .25rem 1.1rem .8rem; }
  .chat__chips :global(button) { padding: .45rem .7rem; font: 600 .75rem/1.2 var(--font-body); color: var(--text-strong); background: transparent; border: 1px solid var(--line-strong); cursor: pointer; text-align: left; transition: border-color .25s, color .25s, transform .3s var(--ease-brand); }
  .chat__chips :global(button:hover) { border-color: var(--gold); color: var(--accent-text); transform: translateY(-1px); }

  .chat__form { display: flex; gap: .5rem; padding: .75rem 1.1rem 1rem; border-top: 1px solid var(--line); }
  .chat__form input { flex: 1; min-width: 0; padding: .7rem .8rem; background: var(--bg-inset); color: var(--text-strong); border: 1px solid var(--line-strong); border-radius: var(--radius-sm); font: 500 .875rem var(--font-body); }
  .chat__form input::placeholder { color: var(--text-dim); }
  .chat__form button { display: grid; place-items: center; width: 2.6rem; flex: none; background: var(--gold); color: #080808; border: 0; border-radius: var(--radius-sm); cursor: pointer; transition: background-color .2s, transform .2s; }
  .chat__form button:hover { background: var(--gold-bright); }
  .chat__form button:active { transform: scale(.95); }
  .chat__form button :global(svg) { width: 1.1rem; height: 1.1rem; }
  .chat__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>
