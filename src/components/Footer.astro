---
import { getLangFromUrl, routePath } from '../i18n/utils';
import Wordmark from './Wordmark.astro';
import { CONTACT_EMAIL } from '../consts';
const lang = getLangFromUrl(Astro.url);
const links = lang === 'es' ? ['Privacidad', 'Términos', 'Cookies'] : ['Privacy', 'Terms', 'Cookies'];
---
<footer class="footer">
  <div class="shell footer__inner">
    <Wordmark lang={lang} size={18} />
    <a class="email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    <nav aria-label={lang === 'es' ? 'Información legal' : 'Legal information'}>
      {(['privacy','terms','cookies'] as const).map((route,i) => <a href={routePath(route,lang)}>{links[i]}</a>)}
    </nav>
    <p>© {new Date().getFullYear()} VIRAND</p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--line); padding-block: 3rem; }
  .footer__inner { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 2rem; font-size: .8125rem; }
  .email { color: var(--text-strong); }
  nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  a:hover { color: var(--accent-text); }
  p { margin: 0; text-align: right; }
  @media(max-width: 639px) { .footer__inner { grid-template-columns: 1fr; } p { text-align: left; } }
</style>
