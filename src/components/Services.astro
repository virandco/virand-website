---
import { landingCopy } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
const copy = landingCopy[getLangFromUrl(Astro.url)].custom;
---
<section class="section custom" id="a-medida"><div class="shell">
  <header data-reveal><h2>{copy.title}</h2><p class="intro">{copy.intro}</p></header>
  <dl>{copy.items.map(item => <div data-reveal><dt>{item.title}</dt><dd>{item.body}</dd></div>)}</dl>
</div></section>
<style>
  .custom { background: var(--bg-raised); }
  h2 { font-weight: 700; max-width: 17ch; font-size: clamp(2.5rem,5vw,4.5rem); margin: 0; }
  .intro { max-width: 48ch; margin: 1.5rem 0 3.5rem; font-size: clamp(1rem,1.4vw,1.15rem); }
  dl { display: grid; grid-template-columns: repeat(2,1fr); column-gap: 5rem; row-gap: 2.5rem; margin: 0; }
  dl>div { border-left: 1px solid var(--line-wine); padding-left: 1.5rem; }
  dt { color: var(--text-strong); font: 700 clamp(1.5rem,2.2vw,2rem)/1.1 var(--font-display); }
  dd { margin: .75rem 0 0; max-width: 40ch; font-size: .95rem; }
  @media(max-width: 767px) { dl { grid-template-columns: 1fr; gap: 2rem; } }
</style>
