---
import { getLangFromUrl } from '../i18n/utils';
import { heroCopy } from '../i18n/ui';
import ActionPair from './ActionPair.astro';
const lang = getLangFromUrl(Astro.url);
const copy = heroCopy[lang];
---
{/* The clip follows the theme: dark.mp4 in dark mode, light.mp4 in light mode.
    It pins briefly, then keeps playing while the hero scrolls away (mode "trail"). */}
<section class="hero" id="inicio" data-scrub="trail" data-scrub-themed="/media/hero" data-scrub-eager>
  <div class="hero__stage">
    <div class="hero__media" aria-hidden="true">
      <img class="hero__poster" data-when="dark" src="/media/hero-dark-poster.jpg" width="1280" height="720" alt="" fetchpriority="high" loading="eager" />
      <img class="hero__poster" data-when="light" src="/media/hero-light-poster.jpg" width="1280" height="720" alt="" loading="eager" />
      <video class="hero__video" muted playsinline preload="none" data-scrub-video style="transform: translateZ(0); -webkit-transform: translateZ(0); -webkit-backface-visibility: hidden; backface-visibility: hidden;"></video>
      <div class="hero__scrim"></div>
    </div>
    <div class="hero__inner shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="hero__body">{copy.body}</p>
      <ActionPair lang={lang} />
    </div>
  </div>
</section>
<style>
  /* Dark mode fades to pure black, the color the box clip opens on. */
  .hero { --hero-fade: #000; height: 150svh; position: relative; }
  :global(:root[data-theme="light"]) .hero { --hero-fade: var(--bg); }
  .hero__stage { position: sticky; top: 0; min-height: 100svh; display: grid; align-items: center; overflow: hidden; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__poster, .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% center; }
  .hero__video { opacity: 0; transition: opacity .4s var(--ease-brand); }
  .hero__video[data-ready] { opacity: 1; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(100deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 62%, transparent) 42%, transparent 72%), linear-gradient(to bottom, transparent 50%, var(--hero-fade) 99%); }
  .hero__inner { position: relative; padding-block: 6rem 4rem; }
  h1 { max-width: 16ch; font-size: clamp(2.6rem, 4.9vw, 5rem); line-height: .94; letter-spacing: -.025em; margin: 0; }
  .hero__body { max-width: 34rem; font-size: clamp(1.05rem, 1.5vw, 1.25rem); font-weight: 500; line-height: 1.5; margin: 1.5rem 0 2.25rem; color: var(--text-strong); }
  @media (max-width: 767px) {
    .hero { height: 135svh; }
    .hero__inner { padding-top: 6rem; }
    .hero__poster, .hero__video { object-position: 50% center; }
    h1 { font-size: clamp(2.3rem, 9.5vw, 3.6rem); max-width: 13ch; }
    .hero__body { max-width: 30rem; font-size: 1rem; }
    .hero__scrim { background: linear-gradient(100deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 66%, transparent) 70%, transparent 100%), linear-gradient(to bottom, transparent 50%, var(--hero-fade) 99%); }
  }
  @media (prefers-reduced-motion: reduce) { .hero { height: auto; } .hero__stage { position: relative; } .hero__video { display: none; } }
</style>
