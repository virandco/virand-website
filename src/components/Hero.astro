---
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import WhatsAppCta from './WhatsAppCta.astro';
import heroDark from '../assets/hero-dark.jpeg';
import heroLight from '../assets/hero-light.jpeg';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero" id="inicio">
  <div class="hero__media" aria-hidden="false">
    <Image
      src={heroDark}
      alt={t('hero.imageAlt')}
      class="hero__img"
      data-when="dark"
      widths={[768, 1280, 1920, 2752]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <Image
      src={heroLight}
      alt={t('hero.imageAltLight')}
      class="hero__img"
      data-when="light"
      widths={[768, 1280, 1920, 2752]}
      sizes="100vw"
      loading="eager"
    />
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner shell">
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal>{t('hero.eyebrow')}</p>
      <h1 class="hero__headline" data-reveal style="--reveal-delay: 90ms">
        {t('hero.headline')}
      </h1>
      <p class="hero__phrase" data-reveal style="--reveal-delay: 180ms">
        {t('hero.phrase')}
      </p>
      <div class="hero__cta" data-reveal style="--reveal-delay: 270ms">
        <WhatsAppCta lang={lang} size="md" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding-block: 5.5rem clamp(3rem, 8vh, 5rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 55%, transparent) 0%,
        color-mix(in srgb, var(--bg) 30%, transparent) 40%,
        transparent 70%
      ),
      linear-gradient(
        102deg,
        var(--bg) 0%,
        color-mix(in srgb, var(--bg) 55%, transparent) 44%,
        transparent 74%
      ),
      linear-gradient(to bottom, transparent 60%, var(--bg) 99%);
  }

  @media (min-width: 768px) {
    .hero__scrim {
      background:
        linear-gradient(
          102deg,
          var(--bg) 0%,
          color-mix(in srgb, var(--bg) 60%, transparent) 46%,
          transparent 76%
        ),
        linear-gradient(to bottom, transparent 62%, var(--bg) 99%);
    }
  }

  .hero__inner {
    width: 100%;
  }

  .hero__content {
    max-width: 34rem;
  }

  .hero__eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .hero__headline {
    margin: 0;
    font-size: clamp(3rem, 8.5vw, 6.5rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }

  .hero__phrase {
    margin: 1.75rem 0 0;
    max-width: 30rem;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--text);
  }

  .hero__cta {
    margin-top: 2.5rem;
  }

  @media (min-width: 768px) {
    .hero__img {
      object-position: center;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: 6rem 4rem;
    }

    .hero__content {
      max-width: 36rem;
    }

    .hero__eyebrow {
      margin-bottom: 2rem;
    }
  }
</style>
