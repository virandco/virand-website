---
import { getLangFromUrl } from '../i18n/utils';
import { heroCopy } from '../i18n/ui';
import ActionPair from './ActionPair.astro';
const lang = getLangFromUrl(Astro.url);
const copy = heroCopy[lang];
---
<section class="hero" id="inicio" data-scroll-hero>
  <div class="hero__stage">
    <div class="hero__media" aria-hidden="true">
      <img class="hero__poster" src="/media/hero-poster.jpg" width="1600" height="900" alt="" fetchpriority="high" loading="eager" />
      <video class="hero__video" muted playsinline preload="none" poster="/media/hero-poster.jpg" data-hero-video style="transform: translateZ(0); -webkit-transform: translateZ(0); -webkit-backface-visibility: hidden; backface-visibility: hidden;"></video>
      <div class="hero__scrim"></div>
    </div>
    <div class="hero__inner shell">
      <h1>{copy.title}</h1>
      <p>{copy.body}</p>
      <ActionPair lang={lang} />
    </div>
  </div>
</section>
<style>
  .hero { height: 165svh; position: relative; }
  .hero__stage { position: sticky; top: 0; min-height: 100svh; display: grid; align-items: center; overflow: hidden; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__poster, .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 65% center; }
  .hero__video { opacity: 0; }
  .hero__video[data-ready] { opacity: 1; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(102deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 60%, transparent) 46%, transparent 76%), linear-gradient(to bottom, transparent 62%, var(--bg) 99%); }
  .hero__inner { padding-block: 6rem 4rem; }
  h1 { max-width: 21ch; font-size: clamp(3rem, 6.4vw, 6.5rem); font-weight: 700; line-height: .96; letter-spacing: -.025em; margin: 0; text-wrap: balance; }
  p { max-width: 38rem; font-size: clamp(1.05rem, 1.6vw, 1.3rem); line-height: 1.5; margin: 1.75rem 0 2.5rem; color: var(--text-strong); }
  @media(max-width: 767px) {
    .hero__stage { min-height: 100svh; }
    .hero__inner { padding-top: 6rem; }
    h1 { font-size: clamp(2.75rem, 10vw, 4.5rem); max-width: 15ch; }
    p { max-width: 30rem; font-size: 1rem; }
    .hero__scrim { background: linear-gradient(102deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 60%, transparent) 70%, transparent 100%), linear-gradient(to bottom, transparent 62%, var(--bg) 99%); }
  }
  @media(prefers-reduced-motion: reduce) { .hero { height: auto; } .hero__stage { position: relative; } }
  .hero[data-static] { height: auto; }
</style>
<script>
  import '../lib/heroScrub';
</script>
