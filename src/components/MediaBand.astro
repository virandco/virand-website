---
interface Props {
  /** Base path of the clip in /public/media, without size suffix (e.g. `/media/motion`). */
  clip: string;
  title: string;
  align?: 'start' | 'end';
  /** The desktop clip starts at a different moment and has its own `-poster-d.jpg`. */
  desktopPoster?: boolean;
}
const { clip, title, align = 'start', desktopPoster = false } = Astro.props;
---
{/* Horizontal cinematic band. The clip advances as the band crosses the
    viewport, with a slow counter-zoom; it stays obsidian in both themes. */}
<section class:list={['band', 'theme-dark', `band--${align}`]} aria-label={title} data-scrub="pass" data-scrub-src={clip}>
  <picture>
    {desktopPoster && <source media="(min-width: 768px)" srcset={`${clip}-poster-d.jpg`} />}
    <img class="band__media" src={`${clip}-poster.jpg`} width="1280" height="720" alt="" loading="lazy" decoding="async" aria-hidden="true" />
  </picture>
  <video class="band__media band__video" muted playsinline preload="none" aria-hidden="true" data-scrub-video style="transform: translateZ(0); -webkit-transform: translateZ(0); -webkit-backface-visibility: hidden; backface-visibility: hidden;"></video>
  <div class="band__scrim" aria-hidden="true"></div>
  <div class="band__caption shell">
    <p class="band__title">{title}</p>
  </div>
</section>
<style>
  .band { position: relative; display: grid; align-items: end; min-height: clamp(320px, 52vh, 560px); overflow: hidden; isolation: isolate; background: #080808; }
  .band__media {
    position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover;
    transform: scale(calc(1.14 - var(--p, .5) * .14));
    will-change: transform;
  }
  .band__video { opacity: 0; transition: opacity .4s var(--ease-brand); }
  .band__video[data-ready] { opacity: 1; }
  .band__scrim { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 80% at 50% 40%, transparent 42%, rgba(8, 8, 8, .55) 100%), linear-gradient(to top, rgba(8, 8, 8, .85) 0%, transparent 58%); }
  .band--end .band__scrim { background: radial-gradient(120% 80% at 50% 40%, transparent 42%, rgba(8, 8, 8, .55) 100%), linear-gradient(to top, rgba(8, 8, 8, .85) 0%, transparent 58%), linear-gradient(to left, rgba(8, 8, 8, .5), transparent 55%); }
  .band__caption { padding-block: clamp(1.75rem, 5vw, 3rem); }
  .band--end .band__caption { text-align: right; }
  .band__title {
    margin: 0; font: 900 clamp(2.1rem, 5.6vw, 4.5rem)/.95 var(--font-display); letter-spacing: -.02em; text-transform: uppercase; color: #fff;
    /* Drifts against the scroll a few viewport points: the type moves with the clip. */
    translate: calc((var(--p, .5) - .5) * -5vw) 0;
  }
  .band--end .band__title { translate: calc((var(--p, .5) - .5) * 5vw) 0; margin-left: auto; max-width: 16ch; }
  @media (max-width: 767px) {
    .band { min-height: clamp(280px, 48svh, 460px); }
    .band__title { font-size: clamp(1.9rem, 9vw, 3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .band__media, .band__title { transform: none; translate: none; }
    .band__video { display: none; }
  }
</style>
