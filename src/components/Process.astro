---
import { landingCopy } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const copy = landingCopy[lang].process;
---
<section class="section process" id="proceso">
  <span class="ghost" aria-hidden="true">02</span>
  <div class="shell">
    <p class="eyebrow" data-reveal>{lang === 'es' ? 'Proceso' : 'Process'}</p>
    <h2 data-reveal>{copy.title}</h2>
    <ol>{copy.steps.map((step, i) => <li data-reveal data-ink-host style={`--reveal-delay:${i * 70}ms`}>
      <span class="order" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="hover-ink">{step.title}</h3><p>{step.body}</p>
    </li>)}</ol>
  </div>
</section>
<style>
  /* Rule and numbers: gold on dark, wine on light (as VIRAND OS does with its accent). */
  .process { --rule: var(--gold); --rule-soft: rgba(201, 168, 76, .45); overflow: hidden; }
  :global(:root[data-theme="light"]) .process { --rule: var(--wine); --rule-soft: var(--line-wine); }
  h2 { max-width: 16ch; font-size: clamp(2.5rem, 5vw, 4.5rem); margin: 0 0 3.5rem; }
  ol { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; padding: 0; margin: 0; list-style: none; }
  li { position: relative; border-top: 2px solid var(--rule-soft); padding: 1.5rem 1rem 1.75rem 0; transition: transform .5s var(--ease-brand); }
  li::before { content: ""; position: absolute; left: 0; right: 0; top: -2px; height: 2px; background: var(--rule); transform: scaleX(0); transform-origin: 0 50%; transition: transform .7s var(--ease-brand); }
  .order { display: block; font: 900 2.1rem/1 var(--font-display); color: var(--rule); margin-bottom: 2rem; transition: transform .5s var(--ease-brand); transform-origin: 0 100%; }
  h3 { font-size: 1.6rem; line-height: 1.1; font-weight: 700; margin: 0 0 1rem; max-width: 16ch; text-transform: uppercase; }
  p { margin: 0; font-size: .95rem; font-weight: 500; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li:hover { transform: translateY(-.35rem); }
    li:hover::before { transform: scaleX(1); }
    li:hover .order { transform: scale(1.25); }
  }
  @media (max-width: 1023px) { ol { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; } }
  @media (max-width: 639px) {
    ol { grid-template-columns: 1fr; }
    li { display: grid; grid-template-columns: 2.75rem 1fr; gap: 0 1rem; }
    .order { grid-row: span 2; margin: .15rem 0 0; font-size: 1.6rem; }
    h3 { max-width: 24ch; } p { grid-column: 2; }
  }
</style>
