---
import { landingCopy } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
const copy = landingCopy[getLangFromUrl(Astro.url)].process;
---
<section class="section process" id="proceso"><div class="shell">
  <h2 data-reveal>{copy.title}</h2>
  <ol>{copy.steps.map((step,i) => <li data-reveal style={`--reveal-delay:${i*70}ms`}>
    <span class="order" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
    <h3>{step.title}</h3><p>{step.body}</p>
  </li>)}</ol>
</div></section>
<style>
  h2 { font-weight: 700; max-width: 16ch; font-size: clamp(2.5rem,5vw,4.5rem); margin: 0 0 3.5rem; }
  ol { display: grid; grid-template-columns: repeat(4,1fr); gap: 2rem; padding: 0; margin: 0; list-style: none; }
  li { border-top: 1px solid var(--line-strong); padding-top: 1.5rem; }
  .order { display: block; font: 700 1rem var(--font-display); color: var(--accent-text); margin-bottom: 2rem; }
  h3 { font-size: 1.6rem; line-height: 1.1; font-weight: 700; margin: 0 0 1rem; max-width: 16ch; }
  p { margin: 0; font-size: .95rem; }
  @media(max-width: 1023px) { ol { grid-template-columns: repeat(2,1fr); gap: 2.5rem; } }
  @media(max-width: 639px) { ol { grid-template-columns: 1fr; } li { display: grid; grid-template-columns: 2rem 1fr; gap: 0 1rem; } .order { grid-row: span 2; margin: .15rem 0 0; } h3 { max-width: 24ch; } p { grid-column: 2; } }
</style>
