---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getRouteKey, routePath } from '../i18n/utils';
import { NOINDEX_ROUTES } from '../consts';
import { THEME_INIT_SCRIPT } from '../lib/themeScript';
import Nav from '../components/Nav.astro';
import Analytics from '../components/Analytics.astro';
import { SOCIAL, CONTACT_EMAIL } from '../consts';
interface Props { title?:string; description?:string; }
const lang=getLangFromUrl(Astro.url), t=useTranslations(lang), route=getRouteKey(Astro.url);
const title=Astro.props.title??t('meta.title'), description=Astro.props.description??t('meta.description');
const abs=(path:string)=>new URL(path,Astro.site).href;
const canonical=abs(route?routePath(route,lang):Astro.url.pathname);
const noindex=route===undefined||NOINDEX_ROUTES.includes(route);
const og=abs('/og/og-'+lang+'.png');
const organization={'@context':'https://schema.org','@type':'Organization',name:'VIRAND',url:abs('/'),logo:abs('/icon-512.png'),email:CONTACT_EMAIL,slogan:'Build Perception',sameAs:SOCIAL.map(item=>item.url)};
---
<!doctype html>
<html lang={lang} data-theme="dark">
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)" /><meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
  <title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} />
  {noindex&&<meta name="robots" content="noindex, follow" />}
  {route&&<><link rel="alternate" hreflang="es" href={abs(routePath(route,'es'))} /><link rel="alternate" hreflang="en" href={abs(routePath(route,'en'))} /><link rel="alternate" hreflang="x-default" href={abs(routePath(route,'es'))} /></>}
  {route==='home'&&<link rel="preload" as="image" href="/media/hero-dark-poster.jpg" fetchpriority="high" />}
  <meta property="og:type" content="website" /><meta property="og:site_name" content="VIRAND" />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:locale" content={lang==='es'?'es_CO':'en_US'} /><meta property="og:locale:alternate" content={lang==='es'?'en_US':'es_CO'} />
  <meta property="og:url" content={canonical} /><meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="VIRAND, Build Perception" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={og} />
  {route==='home'&&<script type="application/ld+json" set:html={JSON.stringify(organization)} />}
  <meta name="generator" content={Astro.generator} />
  <script is:inline set:html={THEME_INIT_SCRIPT}></script>
  <Analytics />
  <noscript><link rel="stylesheet" href="/no-js.css" /></noscript>
 </head>
 <body>
  <a class="skip-link" href="#main">{t('a11y.skip')}</a>
  <Nav /><slot /><div class="grain" aria-hidden="true"></div>
  <script>
   const reduced=matchMedia('(prefers-reduced-motion: reduce)');
   const els=document.querySelectorAll('[data-reveal]');
   const observer=new IntersectionObserver(entries=>{for(const entry of entries) if(entry.isIntersecting){entry.target.classList.add('is-visible');observer.unobserve(entry.target);}},{rootMargin:'0px 0px -5% 0px'});
   for(const el of els) {if(reduced.matches)el.classList.add('is-visible');else observer.observe(el);}
  </script>
 </body>
</html>
