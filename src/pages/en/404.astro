---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ReadingPage from '../../components/ReadingPage.astro';
import { round2NotFoundCopy } from '../../i18n/ui';
const copy = round2NotFoundCopy["en"];
const description = copy.notice || copy.sections.flatMap<{ kind: string; html?: string }>(section => section.blocks)
  .find(block => block.kind === "paragraph")?.html?.replace(/<[^>]+>/g, "") || copy.title;
---

<Layout title={copy.title + " | VIRAND"} description={description}>
  <main id="main">
    <ReadingPage content={copy} />
  </main>
  <Footer />
</Layout>
