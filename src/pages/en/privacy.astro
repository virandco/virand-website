---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ReadingPage from '../../components/ReadingPage.astro';
import { round2LegalCopy } from '../../i18n/ui';
const copy = round2LegalCopy["en"]["privacy"];
const description = copy.description;
---

<Layout title={copy.title + " | VIRAND"} description={description}>
  <main id="main">
    <ReadingPage content={copy} />
  </main>
  <Footer />
</Layout>
