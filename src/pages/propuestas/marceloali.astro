---
// Standalone client pitch — not linked from any nav, not part of the
// public site IA. Spanish only (this client has no reason for an /en/
// version), excluded from indexing on purpose (see <meta name="robots">).
//
// Reuses the site's brand tokens (global.css) and the two structural
// primitives (Section, Wordmark) but skips Layout.astro entirely: no
// site Nav, no Footer, no lang alternates. Opened from a WhatsApp chat
// on a phone, so every section is built to read in ~20 seconds.
import '../../styles/global.css';
import { Icon } from 'astro-icon/components';
import Section from '../../components/Section.astro';
import Wordmark from '../../components/Wordmark.astro';

const title = 'Sistema de Contenido — Marcelo Ali · Moto Planet SBK';
const description =
  'La mediana de views cayó de 42.700 en febrero a 4.300 en agosto: una caída del 90%. Propuesta de sistema de contenido para Moto Planet SBK.';
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const WHATSAPP_URL = 'https://wa.me/573054136971';
const PDF_URL = '/propuestas/marcelo-ali-virand.pdf';

const monthlyViews = [
  { month: 'Ene', value: 41900, label: '41.9K' },
  { month: 'Feb', value: 42700, label: '42.7K' },
  { month: 'Mar', value: 28500, label: '28.5K' },
  { month: 'Abr', value: 15700, label: '15.7K' },
  { month: 'May', value: 16800, label: '16.8K' },
  { month: 'Jun', value: 9600, label: '9.6K' },
  { month: 'Jul', value: 6300, label: '6.3K' },
  { month: 'Ago', value: 4300, label: '4.3K' },
] as const;
const maxViews = Math.max(...monthlyViews.map((d) => d.value));
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VIRAND" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <header class="brand-strip">
      <Wordmark lang="es" size={16} />
    </header>

    <main id="main">
      <!-- 1 · HERO -->
      <section class="hero shell">
        <p class="hero__kicker" data-reveal>Marcelo Ali · Moto Planet SBK</p>
        <h1 data-reveal style="--reveal-delay: 60ms">Sistema de Contenido</h1>
        <p class="hero__lede" data-reveal style="--reveal-delay: 120ms">
          La mediana de views cayó de <strong>42.700</strong> en febrero a
          <strong>4.300</strong> en agosto: una caída del 90&nbsp;%.
        </p>
      </section>

      <!-- 2 · DIAGNÓSTICO -->
      <Section id="diagnostico" mark="01">
        <h2 data-reveal>La caída, mes a mes</h2>

        <figure class="chart" aria-label={`Mediana de views por mes: de ${monthlyViews[0].label} en enero a ${monthlyViews[monthlyViews.length - 1].label} en agosto, con la caída más fuerte a partir de marzo.`}>
          <div class="chart__bars" aria-hidden="true">
            {monthlyViews.map((d, i) => (
              <div
                class="chart__col"
                data-peak={i <= 1 ? '' : undefined}
                data-crisis={i === monthlyViews.length - 1 ? '' : undefined}
              >
                <span class="chart__value">{d.label}</span>
                <span
                  class:list={[
                    'chart__bar',
                    { 'chart__bar--peak': i <= 1, 'chart__bar--crisis': i === monthlyViews.length - 1 },
                  ]}
                  style={`--pct: ${((d.value / maxViews) * 100).toFixed(1)}%`}
                ></span>
                <span class="chart__month">{d.month}</span>
              </div>
            ))}
          </div>
          <figcaption class="sr-only">
            Mediana de views por mes.
            {monthlyViews.map((d) => `${d.month}: ${d.label}.`).join(' ')}
          </figcaption>
        </figure>

        <ul class="diagnosis-list">
          <li data-reveal>
            Los likes por view siguen iguales. Los guardados y compartidos cayeron a la mitad.
          </li>
          <li data-reveal style="--reveal-delay: 60ms">
            Antes el contenido hablaba de la moto. Ahora habla de la tienda.
          </li>
          <li data-reveal style="--reveal-delay: 120ms">
            Pasa igual en Instagram y en TikTok. No es el algoritmo.
          </li>
        </ul>
      </Section>

      <!-- 3 · LA PRUEBA -->
      <Section id="prueba" mark="02">
        <h2 data-reveal>La prueba</h2>

        <div class="proof-grid">
          <article class="proof-card proof-card--win" data-reveal>
            <span class="proof-card__tag">Lo que funcionó</span>
            <h3>El reel de 3.7M</h3>
            <ul>
              <li><Icon name="ph:check-bold" /> Cámara de tercero</li>
              <li><Icon name="ph:check-bold" /> Planos detalle</li>
              <li><Icon name="ph:check-bold" /> Texto en pantalla</li>
              <li><Icon name="ph:check-bold" /> 114 segundos, con estructura</li>
            </ul>
          </article>

          <article class="proof-card proof-card--loss" data-reveal style="--reveal-delay: 80ms">
            <span class="proof-card__tag">Lo que no</span>
            <h3>Pieza reciente de showroom</h3>
            <ul>
              <li><Icon name="ph:x-bold" /> Sin gancho de entrada</li>
              <li><Icon name="ph:x-bold" /> Sin cierre</li>
            </ul>
          </article>
        </div>

        <p class="proof-close" data-reveal>
          No hay que inventar nada. Hay que volver a hacer lo que ya funcionó, con sistema.
        </p>
      </Section>

      <!-- 4 · LAS DOS OPCIONES -->
      <Section id="opciones" mark="03">
        <h2 data-reveal>Las dos opciones</h2>

        <div class="pricing-grid">
          <article class="price-card" data-reveal>
            <h3>Opción 1<span>Sistema de Contenido</span></h3>

            <div class="price-card__price">
              <s class="price-card__was">$3.200.000<span>/mes</span></s>
              <strong class="price-card__now">$1.800.000<span>/mes</span></strong>
              <span class="price-card__badge">Fundador · meses 1-3</span>
              <span class="price-card__then">$2.400.000/mes desde el mes 4</span>
            </div>

            <ul class="price-card__scope">
              <li><Icon name="ph:check-bold" /> 12 reels al mes</li>
              <li><Icon name="ph:check-bold" /> Edición de 8 a 10 videos propios</li>
              <li><Icon name="ph:check-bold" /> Rodaje quincenal</li>
              <li><Icon name="ph:check-bold" /> Reporte mensual</li>
            </ul>
          </article>

          <article class="price-card price-card--featured" data-reveal style="--reveal-delay: 80ms">
            <span class="price-card__recommended">Recomendada</span>
            <h3>Opción 2<span>Contenido + presencia web</span></h3>

            <div class="price-card__price">
              <s class="price-card__was">$4.200.000<span>/mes</span></s>
              <strong class="price-card__now">$2.300.000<span>/mes</span></strong>
              <span class="price-card__badge">Fundador · meses 1-3</span>
              <span class="price-card__then">$2.900.000/mes desde el mes 4</span>
            </div>

            <ul class="price-card__scope">
              <li><Icon name="ph:check-bold" /> Todo lo de la Opción 1</li>
              <li><Icon name="ph:check-bold" /> Catálogo web de motos</li>
              <li><Icon name="ph:check-bold" /> Página de financiación</li>
              <li><Icon name="ph:check-bold" /> Sedes Bogotá y Girardot</li>
              <li><Icon name="ph:check-bold" /> WhatsApps medibles por origen</li>
            </ul>
          </article>
        </div>

        <p class="pricing-fine">
          El precio Fundador es a cambio de acceso a Insights, un caso de estudio y un testimonio al mes 3.
          Permanencia de 3 meses, salida libre al final del mes 1.
        </p>
      </Section>

      <!-- 5 · CTA -->
      <section class="cta shell" id="agendar">
        <h2 data-reveal>¿Agendamos la primera jornada de rodaje?</h2>

        <div class="cta__actions" data-reveal style="--reveal-delay: 60ms">
          <a class="cta__primary" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
            <Icon name="ph:whatsapp-logo-fill" />
            Agendar rodaje
          </a>
          <a class="cta__secondary" href={PDF_URL}>
            <Icon name="ph:file-pdf" />
            Descargar propuesta detallada en PDF
          </a>
        </div>
      </section>
    </main>

    <!-- 6 · FOOTER -->
    <footer class="foot shell">
      <p>
        Fase 2: catálogo con leads medibles. Fase 3: automatización de cotizaciones, inventario y
        recordatorios de mantenimiento. La atención al cliente sigue siendo de Marcelo.
      </p>
    </footer>

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        for (const el of els) el.classList.add('is-visible');
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const el of els) io.observe(el);
      }
    </script>
  </body>
</html>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Brand strip (no nav, just the mark) ---------- */
  .brand-strip {
    padding: 1.1rem clamp(1.25rem, 5vw, 3rem);
  }

  /* ---------- Hero ---------- */
  .hero {
    padding-block: 1.5rem clamp(3rem, 8vh, 5rem);
  }

  .hero__kicker {
    margin: 0 0 0.9rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(2.75rem, 11vw, 5.5rem);
    line-height: 0.98;
  }

  .hero__lede {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
    line-height: 1.55;
    color: var(--text);
  }

  .hero__lede strong {
    color: var(--text-strong);
    font-weight: 700;
  }

  /* ---------- Section headings (shared shape) ---------- */
  :global(.sec) h2 {
    margin: 0 0 clamp(1.75rem, 4vw, 2.5rem);
    font-size: clamp(1.9rem, 5.5vw, 2.75rem);
    line-height: 1;
  }

  /* ---------- Chart ---------- */
  .chart {
    margin: 0 0 clamp(2rem, 5vw, 2.75rem);
  }

  .chart__bars {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.3rem, 1.3vw, 0.75rem);
    height: clamp(8rem, 22vw, 13rem);
    padding-top: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .chart__col {
    flex: 1 1 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    position: relative;
  }

  .chart__value {
    position: absolute;
    bottom: 100%;
    margin-bottom: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .chart__col[data-peak] .chart__value,
  .chart__col[data-crisis] .chart__value {
    color: var(--text-strong);
  }

  .chart__bar {
    width: 100%;
    max-width: 2.5rem;
    height: var(--pct);
    background: var(--line-strong);
  }

  .chart__bar--peak {
    background: var(--gold);
  }

  .chart__bar--crisis {
    background: var(--wine-bright);
  }

  .chart__month {
    margin-top: 0.55rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--text-dim);
  }

  .chart__col[data-crisis] .chart__month {
    color: var(--wine-bright);
    font-weight: 700;
  }

  /* ---------- Diagnosis list ---------- */
  .diagnosis-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnosis-list li {
    padding-left: 1.1rem;
    border-left: 2px solid var(--line-wine);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text);
  }

  /* ---------- Proof cards ---------- */
  .proof-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.25rem);
  }

  @media (min-width: 700px) {
    .proof-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .proof-card {
    padding: clamp(1.5rem, 3.5vw, 2rem);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }

  .proof-card--win {
    border-color: var(--line-wine);
  }

  .proof-card--loss {
    opacity: 0.72;
  }

  .proof-card__tag {
    display: inline-block;
    margin-bottom: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-card--win .proof-card__tag {
    color: var(--accent-text);
  }

  .proof-card--loss .proof-card__tag {
    color: var(--text-dim);
  }

  .proof-card h3 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    text-transform: none;
    color: var(--text-strong);
  }

  .proof-card ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .proof-card li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .proof-card--win li :global(svg) {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    color: var(--gold);
  }

  .proof-card--loss li :global(svg) {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    color: var(--text-dim);
  }

  .proof-close {
    margin: 0;
    max-width: 38rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.2rem, 3vw, 1.55rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--gold-bright);
    text-transform: none;
    padding-bottom: 0.15em;
  }

  /* ---------- Pricing ---------- */
  .pricing-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 760px) {
    .pricing-grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .price-card {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }

  .price-card--featured {
    border-color: var(--gold);
  }

  .price-card__recommended {
    position: absolute;
    top: 0;
    right: clamp(1.5rem, 3.5vw, 2.25rem);
    transform: translateY(-50%);
    padding: 0.3rem 0.7rem;
    background: var(--gold);
    color: var(--cta-text);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .price-card h3 {
    margin: 0 0 1.4rem;
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    line-height: 1.1;
    color: var(--text-strong);
  }

  .price-card h3 span {
    display: block;
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8125rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-dim);
  }

  .price-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.6rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--line);
  }

  .price-card__was {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-dim);
    text-decoration-color: var(--wine-bright);
    text-decoration-thickness: 1.5px;
  }

  .price-card__was span {
    font-size: 0.8em;
  }

  .price-card__now {
    display: block;
    width: 100%;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.7rem, 4.2vw, 2.15rem);
    color: var(--text-strong);
  }

  .price-card__now span {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.65em;
    color: var(--text-dim);
  }

  .price-card__badge {
    display: inline-block;
    padding: 0.2rem 0.55rem;
    background: var(--line-wine);
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .price-card__then {
    width: 100%;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .price-card__scope {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .price-card__scope li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--text);
  }

  .price-card__scope li :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2em;
    width: 1em;
    height: 1em;
    color: var(--gold);
  }

  .pricing-fine {
    max-width: 42rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-dim);
  }

  /* ---------- CTA ---------- */
  .cta {
    padding-block: clamp(3rem, 7vh, 4.5rem) clamp(3.5rem, 8vh, 5rem);
    text-align: center;
  }

  .cta h2 {
    margin: 0 0 1.75rem;
    font-size: clamp(1.7rem, 5vw, 2.35rem);
    line-height: 1.08;
  }

  .cta__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.05rem 2rem;
    background: var(--cta-bg);
    color: var(--cta-text);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition:
      background-color 0.2s var(--ease-brand),
      transform 0.12s var(--ease-brand);
  }

  .cta__primary:hover {
    background: var(--cta-bg-hover);
  }

  .cta__primary:active {
    transform: translateY(1px);
  }

  .cta__primary :global(svg) {
    width: 1.15em;
    height: 1.15em;
  }

  .cta__secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-dim);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
    transition: color 0.2s var(--ease-brand), border-color 0.2s var(--ease-brand);
  }

  .cta__secondary:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  .cta__secondary :global(svg) {
    width: 1em;
    height: 1em;
  }

  /* ---------- Footer ---------- */
  .foot {
    padding-block: 1.75rem clamp(2.5rem, 6vh, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .foot p {
    max-width: 44rem;
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-dim);
  }
</style>
